{
  "name": "fours-a-crowd",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute fours-a-crowd --local --file=schema.sql",
    "db:init": "wrangler d1 execute fours-a-crowd --remote --file=schema.sql",
    "photos": "node tools/build-photos.mjs",
    "build": "node tools/validate-sets.mjs && node tools/build-photos.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
